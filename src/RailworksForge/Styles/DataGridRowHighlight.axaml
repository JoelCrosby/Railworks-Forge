<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RailworksForge.ViewModels"
        xmlns:util="using:RailworksForge.Util">

    <Style Selector="DataGrid.consist-highlight DataGridRow" x:DataType="vm:ConsistViewModel">
        <Setter Property="util:DataGridRowHighlight.State" Value="{Binding Highlight}" />
    </Style>

    <Style Selector="DataGridRow[(util|DataGridRowHighlight.State)=Missing]">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="DataGridRow[(util|DataGridRowHighlight.State)=Partial]">
        <Setter Property="Background" Value="{DynamicResource PartialBrush}" />
    </Style>

    <Style Selector="DataGridRow[(util|DataGridRowHighlight.State)=Player]">
        <Setter Property="Background" Value="{DynamicResource IsPlayerBrush}" />
    </Style>
</Styles>
