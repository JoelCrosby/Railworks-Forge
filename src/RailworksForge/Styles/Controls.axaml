<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Default" />
                <Button Classes="primary" Content="Primary" />
                <Button Classes="danger" Content="Danger" />
                <Button Classes="ghost" Content="Ghost" />
                <Button Classes="small" Content="Small" />
                <Button Classes="chip on" Content="All" />
            </StackPanel>
            <Border Classes="card" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="heading" Text="Heading" />
                    <TextBlock Classes="muted" Text="Muted text" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Transparent until hovered; used in toolbars and the header. -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
    </Style>

    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HeaderSelectedBrush}" />
    </Style>

    <Style Selector="Button.ghost:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HeaderSelectedBrush}" />
    </Style>

    <!-- Filter chips: rounded, and filled with the accent while their filter is on. -->
    <Style Selector="Button.chip">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>

    <Style Selector="Button.chip.on">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentSubtleForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentSubtleForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="MinWidth" Value="240" />
    </Style>
</Styles>
