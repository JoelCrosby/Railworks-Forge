<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:converters="using:RailworksForge.Converters"
        xmlns:controls="using:RailworksForge.Views.TemplatedControls">
    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16">
            <controls:AcquisitionStateIcon State="Found" />
            <controls:AcquisitionStateIcon State="Partial" />
            <controls:AcquisitionStateIcon State="Missing" />
            <controls:AcquisitionStateIcon State="Unknown" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|AcquisitionStateIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Lucide draws at its 24px design size, so scale the icon to the control's size. -->
                <Viewbox ToolTip.Tip="{TemplateBinding State, Converter={x:Static converters:ValueConverters.AcquisitionStateTooltipConverter}}">
                    <Panel Width="24" Height="24">
                        <lucideAvalonia:Lucide Icon="{TemplateBinding State, Converter={x:Static converters:ValueConverters.AcquisitionStateIconConverter}}"
                                               StrokeBrush="{TemplateBinding Foreground}"
                                               StrokeThickness="2.5" />
                    </Panel>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|AcquisitionStateIcon[State=Found]">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="controls|AcquisitionStateIcon[State=Partial]">
        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>

    <Style Selector="controls|AcquisitionStateIcon[State=Missing]">
        <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
</Styles>
