<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:components="using:RailworksForge.Views.Components">
    <Design.PreviewWith>
        <Border Padding="16">
            <components:SearchBox Placeholder="Search 258 routes" ShortcutHint="Ctrl F" />
        </Border>
    </Design.PreviewWith>

    <Style Selector="components|SearchBox">
        <Setter Property="Width" Value="280" />
        <Setter Property="Template">
            <ControlTemplate>
                <TextBox Name="PART_TextBox"
                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                         PlaceholderText="{TemplateBinding Placeholder}"
                         VerticalContentAlignment="Center"
                         CornerRadius="{StaticResource RadiusMedium}">
                    <!-- The theme's solid text box fill (black in dark mode) stands out against the page, so use translucent tints that sit just off it. -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.05" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.08" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource SystemAltHighColor}" Opacity="0.3" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.12" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.2" />
                    </TextBox.Resources>
                    <TextBox.InnerLeftContent>
                        <components:LucideIcon Icon="Search"
                                          Width="14"
                                          Height="14"
                                          Margin="10,0,0,0"
                                          StrokeThickness="2"
                                          StrokeBrush="{DynamicResource TextMutedBrush}" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Border Margin="0,0,8,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource RadiusSmall}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                IsVisible="{Binding ShortcutHint, RelativeSource={RelativeSource AncestorType=components:SearchBox}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <!-- The TextBox hosts this content, so it is bound to the search box by ancestor rather than TemplateBinding. -->
                            <TextBlock Classes="caption muted"
                                       FontSize="11"
                                       Text="{Binding ShortcutHint, RelativeSource={RelativeSource AncestorType=components:SearchBox}}" />
                        </Border>
                    </TextBox.InnerRightContent>
                </TextBox>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
