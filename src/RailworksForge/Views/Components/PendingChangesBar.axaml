<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:RailworksForge.Views.Components">
    <Design.PreviewWith>
        <components:PendingChangesBar Width="900"
                                      Summary="1 unsaved change"
                                      Details="Deleted service IC 826. A backup is made before saving."
                                      DiscardText="Discard"
                                      ApplyText="Save scenario" />
    </Design.PreviewWith>

    <Style Selector="components|PendingChangesBar">
        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Text="{TemplateBinding Summary}" />
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,16,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.85"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{TemplateBinding Details}"
                                   ToolTip.Tip="{TemplateBinding Details}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost"
                                    Foreground="{TemplateBinding Foreground}"
                                    Command="{TemplateBinding DiscardCommand}"
                                    Content="{TemplateBinding DiscardText}" />
                            <Button Classes="primary"
                                    Command="{TemplateBinding ApplyCommand}"
                                    Content="{TemplateBinding ApplyText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
