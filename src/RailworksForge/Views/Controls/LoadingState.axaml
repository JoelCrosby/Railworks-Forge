<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:controls="using:RailworksForge.Views.TemplatedControls"
             x:Class="RailworksForge.Views.Controls.LoadingState"
             x:DataType="vm:LoadingOperation"
             IsVisible="{Binding IsVisible}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Margin="16"
             ZIndex="1">

    <!-- Place this in the same cell as the content it describes so it floats above it without taking layout space. -->
    <UserControl.Styles>
        <Style Selector="controls|LoadingSpinner">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style Selector="loading|LoadingState.compact">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="loading|LoadingState.compact Border#Card">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>

        <Style Selector="loading|LoadingState.compact controls|LoadingSpinner">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Styles>

    <Border Name="Card"
            Padding="16,12"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BoxShadow="0 4 16 0 #40000000">
        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="600">
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsLoading}">
                <controls:LoadingSpinner IsActive="{Binding IsLoading}" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="{echoes:Translate {x:Static translations:Strings.retry}}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                <Button Content="{echoes:Translate {x:Static translations:Strings.close}}" Command="{Binding DismissCommand}" IsVisible="{Binding CanDismiss}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
