<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:RailworksForge.DesignData"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:components="using:RailworksForge.Views.Components"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="52"
             x:Class="RailworksForge.Views.Controls.NavigationBar"
             x:DataType="vm:NavigationBarViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.NavigationBar" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.header">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.header.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- LucideIcon is styled as a Lucide control, so its styles select the Lucide type. -->
        <Style Selector="lucideAvalonia|Lucide.header-icon">
            <Setter Property="StrokeBrush" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="lucideAvalonia|Lucide.menu-icon">
            <Setter Property="StrokeBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Styles>

    <Border Height="52"
            Padding="14,0,10,0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource DividerBrush}">

        <DockPanel HorizontalSpacing="10">
            <Image DockPanel.Dock="Left"
                   Source="avares://RailworksForge/Assets/railworks-forge-icon.png"
                   Width="24"
                   Height="24"
                   VerticalAlignment="Center" />

            <Button DockPanel.Dock="Left"
                    Classes="ghost header"
                    Width="32"
                    Padding="0"
                    Command="{Binding GoBackCommand}"
                    ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.back}}">
                <components:LucideIcon Classes="header-icon" Icon="ChevronLeft" />
            </Button>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ghost header"
                        Padding="10,0,8,0"
                        IsEnabled="{Binding Tools.Operations.IsIdle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Command="{Binding Tools.InstallPackageCommand}">
                                <MenuItem.Icon>
                                    <components:LucideIcon Classes="menu-icon" Icon="Package" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.install_package}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>

                            <Separator />

                            <MenuItem Command="{Binding Tools.ConvertBinToXmlCommand}">
                                <MenuItem.Icon>
                                    <components:LucideIcon Classes="menu-icon" Icon="FileCode" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.convert_bin_to_xml}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>

                            <MenuItem Command="{Binding Tools.ConvertXmlToBinCommand}">
                                <MenuItem.Icon>
                                    <components:LucideIcon Classes="menu-icon" Icon="Binary" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.convert_xml_to_bin}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <components:LucideIcon Classes="header-icon" Icon="Wrench" />
                        <TextBlock VerticalAlignment="Center" Text="{echoes:Translate {x:Static translations:Strings.tools}}" />
                        <components:LucideIcon Classes="header-icon" Icon="ChevronDown" Width="14" Height="14" StrokeBrush="{DynamicResource HeaderMutedForegroundBrush}" />
                    </StackPanel>
                </Button>

                <Button Classes="ghost header"
                        Classes.active="{Binding IsSettingsActive}"
                        Width="32"
                        Padding="0"
                        Command="{Binding ShowSettingsCommand}"
                        ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.settings}}">
                    <components:LucideIcon Classes="header-icon" Icon="Settings" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <!-- DockPanel limits each crumb to the space left, so long names trim instead of covering the tools. -->
            <Border Height="32"
                    Padding="3,0"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HeaderTrayBrush}">
                <Panel>
                    <DockPanel LastChildFill="False" IsVisible="{Binding ShowsTrail}">
                        <components:BreadcrumbItem DockPanel.Dock="Left"
                                                   HasSeparator="False"
                                                   Icon="Route"
                                                   IconBackground="{DynamicResource CrumbRoutesBrush}"
                                                   Text="{echoes:Translate {x:Static translations:Strings.routes}}"
                                                   IsCurrent="{Binding IsRoutesCrumbCurrent}"
                                                   Command="{Binding ShowRoutesCommand}" />

                        <components:BreadcrumbItem DockPanel.Dock="Left"
                                                   Icon="Milestone"
                                                   IconBackground="{DynamicResource CrumbRouteBrush}"
                                                   Text="{Binding Navigation.CurrentRoute.Name}"
                                                   IsCurrent="{Binding IsRouteCrumbCurrent}"
                                                   IsVisible="{Binding HasRoute}"
                                                   Command="{Binding ShowRouteCommand}" />

                        <components:BreadcrumbItem DockPanel.Dock="Left"
                                                   Icon="ListEnd"
                                                   IconBackground="{DynamicResource CrumbScenarioBrush}"
                                                   Text="{Binding Navigation.CurrentScenario.Name}"
                                                   IsCurrent="{Binding IsScenarioCrumbCurrent}"
                                                   IsDirty="{Binding IsScenarioDirty}"
                                                   DirtyText="{echoes:Translate {x:Static translations:Strings.unsaved_changes_marker}}"
                                                   IsVisible="{Binding HasScenario}"
                                                   Command="{Binding ShowScenarioCommand}" />

                        <components:BreadcrumbItem DockPanel.Dock="Left"
                                                   Icon="TrainFront"
                                                   IconBackground="{DynamicResource CrumbConsistBrush}"
                                                   Text="{Binding Navigation.CurrentConsist.ServiceName}"
                                                   IsCurrent="{Binding IsConsistCrumbCurrent}"
                                                   IsVisible="{Binding HasConsist}"
                                                   Command="{Binding ShowConsistCommand}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False" IsVisible="{Binding IsSettingsActive}">
                        <components:BreadcrumbItem DockPanel.Dock="Left"
                                                   HasSeparator="False"
                                                   IsCurrent="True"
                                                   Icon="Settings"
                                                   IconBackground="{DynamicResource CrumbSettingsBrush}"
                                                   Text="{echoes:Translate {x:Static translations:Strings.settings}}" />
                    </DockPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
