<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:RailworksForge.DesignData"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:controls="using:RailworksForge.Views.Controls"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="52"
             x:Class="RailworksForge.Views.Controls.NavigationBar"
             x:DataType="vm:NavigationBarViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.NavigationBar" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="lucideAvalonia|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="lucideAvalonia|Lucide.muted">
            <Setter Property="StrokeBrush" Value="{DynamicResource HeaderMutedForegroundBrush}" />
        </Style>

        <!-- Flat header buttons: transparent until hovered, with the hover wash drawn by the template's presenter. -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
        </Style>

        <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderSelectedBrush}" />
        </Style>

        <Style Selector="Button.flat:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderSelectedBrush}" />
        </Style>

        <Style Selector="Button.flat.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!-- Breadcrumbs: earlier crumbs are muted links, the current crumb is highlighted and inert. -->
        <Style Selector="Button.crumb">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MaxWidth" Value="200" />
        </Style>

        <Style Selector="Button.crumb TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderMutedForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Button.crumb lucideAvalonia|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource HeaderMutedForegroundBrush}" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style Selector="Button.crumb:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>

        <Style Selector="Button.crumb:pointerover lucideAvalonia|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource TextControlForeground}" />
        </Style>

        <Style Selector="Button.crumb.current">
            <Setter Property="Background" Value="{DynamicResource HeaderSelectedBrush}" />
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Button.crumb.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>

        <Style Selector="Button.crumb.current lucideAvalonia|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource TextControlForeground}" />
        </Style>

        <Style Selector="lucideAvalonia|Lucide.chevron">
            <Setter Property="StrokeBrush" Value="{DynamicResource HeaderChevronBrush}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Routes search and layout toggle. -->
        <Style Selector="TextBox.header-search">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0,10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
            <Setter Property="Background" Value="{DynamicResource HeaderInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox.header-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderInputBorderBrush}" />
        </Style>

        <Style Selector="TextBox.header-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource HeaderInputBrush}" />
        </Style>

        <Style Selector="Button.toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
        </Style>

        <Style Selector="Button.toggle.on">
            <Setter Property="Background" Value="{DynamicResource HeaderToggleOnBrush}" />
        </Style>

        <Style Selector="Button.toggle.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderToggleOnBrush}" />
        </Style>

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="MinWidth" Value="240" />
        </Style>
    </UserControl.Styles>

    <Border Height="52"
            Padding="14,0,10,0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemChromeDisabledHighColor}">

        <DockPanel HorizontalSpacing="12">
            <Image DockPanel.Dock="Left"
                   Source="avares://RailworksForge/Assets/railworks-forge-icon.png"
                   Width="24"
                   Height="24"
                   VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="flat"
                        Height="32"
                        Padding="10,0,8,0"
                        IsEnabled="{Binding Tools.Operations.IsIdle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Command="{Binding Tools.InstallPackageCommand}">
                                <MenuItem.Icon>
                                    <controls:LucideIcon Icon="Package" Width="16" Height="16" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.install_package}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>

                            <Separator />

                            <MenuItem Command="{Binding Tools.ConvertBinToXmlCommand}">
                                <MenuItem.Icon>
                                    <controls:LucideIcon Icon="FileCode" Width="16" Height="16" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.convert_bin_to_xml}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>

                            <MenuItem Command="{Binding Tools.ConvertXmlToBinCommand}">
                                <MenuItem.Icon>
                                    <controls:LucideIcon Icon="Binary" Width="16" Height="16" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="{echoes:Translate {x:Static translations:Strings.convert_xml_to_bin}}" /><Run Text="…" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LucideIcon Icon="Wrench" />
                        <TextBlock Text="{echoes:Translate {x:Static translations:Strings.tools}}" />
                        <controls:LucideIcon Classes="muted" Icon="ChevronDown" Width="14" Height="14" />
                    </StackPanel>
                </Button>

                <Button Classes="flat"
                        Classes.active="{Binding Navigation.IsSettingsActive}"
                        Width="32"
                        Height="32"
                        Command="{Binding ShowSettingsCommand}"
                        ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.settings}}">
                    <controls:LucideIcon Icon="Settings" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Width="1"
                    Height="20"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemChromeDisabledHighColor}" />

            <ContentControl DockPanel.Dock="Right" Content="{Binding RoutesPage}" VerticalAlignment="Center">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:RoutesViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox Classes="header-search"
                                     Text="{Binding SearchTerm}"
                                     PlaceholderText="{Binding SearchPlaceholder}">
                                <TextBox.InnerLeftContent>
                                    <controls:LucideIcon Classes="muted" Icon="Search" Width="14" Height="14" Margin="10,0,0,0" />
                                </TextBox.InnerLeftContent>
                            </TextBox>

                            <Border Padding="2"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Background="{DynamicResource HeaderInputBrush}"
                                    BorderBrush="{DynamicResource HeaderToggleBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="flat toggle"
                                            Classes.on="{Binding IsListLayout}"
                                            Command="{Binding ShowListCommand}"
                                            ToolTip.Tip="List">
                                        <controls:LucideIcon Icon="List" />
                                    </Button>
                                    <Button Classes="flat toggle"
                                            Classes.on="{Binding IsGridLayout}"
                                            Command="{Binding ShowGridCommand}"
                                            ToolTip.Tip="Grid">
                                        <controls:LucideIcon Icon="LayoutGrid" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- A StackPanel would give the crumbs unlimited width; DockPanel limits each to the space left, so long names trim instead of covering the tools. -->
            <Border Height="32"
                    Padding="3,0"
                    CornerRadius="6"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HeaderTrayBrush}">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Classes="flat crumb"
                            Classes.current="{Binding IsRoutesCrumbCurrent}"
                            Command="{Binding ShowRoutesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:LucideIcon Icon="Route" />
                            <TextBlock Text="{echoes:Translate {x:Static translations:Strings.routes}}" />
                        </StackPanel>
                    </Button>

                    <controls:LucideIcon DockPanel.Dock="Left"
                                           Classes="chevron"
                                           Icon="ChevronRight"
                                           IsVisible="{Binding Navigation.CurrentRoute, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Button DockPanel.Dock="Left"
                            Classes="flat crumb"
                            Classes.current="{Binding IsRouteCrumbCurrent}"
                            Command="{Binding ShowRouteCommand}"
                            IsVisible="{Binding Navigation.CurrentRoute, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{Binding Navigation.CurrentRoute.Name}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:LucideIcon Icon="Milestone" />
                            <TextBlock Text="{Binding Navigation.CurrentRoute.Name}" />
                        </StackPanel>
                    </Button>

                    <controls:LucideIcon DockPanel.Dock="Left"
                                           Classes="chevron"
                                           Icon="ChevronRight"
                                           IsVisible="{Binding Navigation.CurrentScenario, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Button DockPanel.Dock="Left"
                            Classes="flat crumb"
                            Classes.current="{Binding IsScenarioCrumbCurrent}"
                            Command="{Binding ShowScenarioCommand}"
                            IsVisible="{Binding Navigation.CurrentScenario, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{Binding Navigation.CurrentScenario.Name}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:LucideIcon Icon="ListEnd" />
                            <TextBlock Text="{Binding Navigation.CurrentScenario.Name}" />
                        </StackPanel>
                    </Button>

                    <controls:LucideIcon DockPanel.Dock="Left"
                                           Classes="chevron"
                                           Icon="ChevronRight"
                                           IsVisible="{Binding Navigation.CurrentConsist, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Button DockPanel.Dock="Left"
                            Classes="flat crumb"
                            Classes.current="{Binding IsConsistCrumbCurrent}"
                            Command="{Binding ShowConsistCommand}"
                            IsVisible="{Binding Navigation.CurrentConsist, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{Binding Navigation.CurrentConsist.ServiceName}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:LucideIcon Icon="TrainFront" />
                            <TextBlock Text="{Binding Navigation.CurrentConsist.ServiceName}" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
