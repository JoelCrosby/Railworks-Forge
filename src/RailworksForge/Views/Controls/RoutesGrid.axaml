<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RailworksForge.Views.Controls.RoutesGrid"
             x:DataType="vm:RoutesBaseViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.route-cards ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ListBox.route-cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.route-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>

        <Style Selector="ListBox.route-cards ListBoxItem:pointerover Border.route-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
        </Style>

        <Style Selector="ListBox.route-cards ListBoxItem:selected Border.route-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Panel>
            <ScrollViewer>

                <Border Padding="12" IsVisible="{Binding !IsLoading}">
                    <ListBox
                        Classes="route-cards"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding ListItems}"
                        Background="Transparent"
                        DoubleTapped="DataGrid_OnDoubleTapped"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="route-card" Width="256">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Border.ClipToBounds clips square corners, so round the image's top corners itself; the clip extends past the bottom edge to leave those square. -->
                                        <Image Height="128" Source="{Binding ImageBitmap}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,252,140" RadiusX="6" RadiusY="6" />
                                            </Image.Clip>
                                        </Image>
                                        <Border Padding="12,10">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </ScrollViewer>
            <loading:LoadingState DataContext="{Binding Loading}" />
        </Panel>
    </DockPanel>


</UserControl>
