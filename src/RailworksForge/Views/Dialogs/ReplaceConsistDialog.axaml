<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="using:RailworksForge.DesignData"
             xmlns:loading="using:RailworksForge.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RailworksForge.ViewModels"
        xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:controls="using:RailworksForge.Views.Components"
        xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
        xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RailworksForge.Views.Dialogs.ReplaceConsistDialog"
        x:DataType="vm:ReplaceConsistViewModel"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Title="{echoes:Translate {x:Static translations:Strings.replace_consist_title}}">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.ReplaceConsist" />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}" Text="{echoes:Translate {x:Static translations:Strings.select_consist}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,4,3*">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <controls:SectionHeader Title="{echoes:Translate {x:Static translations:Strings.available_stock}}" />
                </StackPanel>

                <Panel>
                    <TreeView ItemsSource="{Binding DirectoryTree}" SelectedItem="{Binding SelectedDirectory}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Subfolders}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:LucideIcon Icon="Folder" Width="16" Height="16" StrokeThickness="1.75" StrokeBrush="{DynamicResource TextMutedBrush}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>

                        <TreeView.ContextMenu>
                            <ContextMenu Opening="ContextMenu_OnOpening">
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" Command="{Binding OpenInExplorerCommand}"  />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.load_consists}}" Command="{Binding LoadAvailableStockCommand}"  />
                            </ContextMenu>
                        </TreeView.ContextMenu>

                    </TreeView>
                    <loading:LoadingState DataContext="{Binding Loading}" />
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource DividerBrush}"
                          ResizeDirection="Columns"
            />

            <Border Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <controls:SectionHeader Title="{echoes:Translate {x:Static translations:Strings.consist}}" />
                    </StackPanel>

                    <Panel>
                        <DataGrid
                            Name="PreloadConsistsDataGrid"
                            ItemsSource="{Binding PreloadConsists}"
                            SelectedItem="{Binding SelectedConsist, Mode=TwoWay}"
                            SelectionMode="Single"
                        >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.image}}" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:PreloadConsistViewModel">
                                            <controls:Thumbnail Width="92" Height="52" Margin="12,6" HorizontalAlignment="Left" Source="{Binding ImageBitmap}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.locomotive_name}}" Binding="{Binding Consist.LocomotiveName}" />
                                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.display_name}}" Binding="{Binding Consist.DisplayName}" />
                                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.engine_type}}" Binding="{Binding Consist.EngineType}" />
                                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.length}}" Binding="{Binding Consist.ConsistEntries.Count}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:EmptyState Icon="FolderOpen"
                                             Title="{echoes:Translate {x:Static translations:Strings.choose_folder}}"
                                             Hint="{echoes:Translate {x:Static translations:Strings.pick_consist_folder_hint}}"
                                             IsVisible="{Binding ShowsFolderPrompt}" />
                        <controls:EmptyState Icon="FolderOpen"
                                             Title="{echoes:Translate {x:Static translations:Strings.folder_has_no_consists}}"
                                             IsVisible="{Binding ShowsEmptyFolder}" />
                        <loading:LoadingState DataContext="{Binding StockLoading}" />
                    </Panel>

                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Height="64" Padding="24,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding DismissCommand}" Content="{echoes:Translate {x:Static translations:Strings.cancel}}" />
                <Button Classes="primary" Command="{Binding ReplaceConsistCommand}" Content="{echoes:Translate {x:Static translations:Strings.replace_consist}}" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
