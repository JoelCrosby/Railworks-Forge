<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
        xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
        xmlns:design="using:RailworksForge.DesignData"
             xmlns:loading="using:RailworksForge.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RailworksForge.ViewModels"
        xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
        xmlns:bh="using:RailworksForge.Behaviours"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RailworksForge.Views.Dialogs.ReplaceTrackDialog"
        x:DataType="vm:ReplaceTrackViewModel"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Title="{echoes:Translate {x:Static translations:Strings.replace_track_title}}">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.ReplaceTrack" />
    </Design.DataContext>


    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}" Text="{echoes:Translate {x:Static translations:Strings.replace_tracks}}" />
            </StackPanel>
        </Border>

        <loading:LoadingState Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Loading}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*" IsVisible="{Binding !IsLoading}" Margin="12,24,12,12">

            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
            </Grid.Styles>

            <TextBlock Grid.Column="0" Text="{echoes:Translate {x:Static translations:Strings.route_track}}" Margin="8,0,0,0" />
            <Grid Grid.Column="2" ColumnDefinitions="*,8,*,8,2*">
                <TextBlock Grid.Column="0" Text="{echoes:Translate {x:Static translations:Strings.provider}}" />
                <TextBlock Grid.Column="2" Text="{echoes:Translate {x:Static translations:Strings.product}}" />
                <TextBlock Grid.Column="4" Text="{echoes:Translate {x:Static translations:Strings.track_blueprint}}" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="12" IsVisible="{Binding !IsLoading}">
            <ScrollViewer>
                <Border Margin="0,0,24,0">
                    <ItemsControl ItemsSource="{Binding RouteTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,12,*">
                                        <StackPanel Grid.Column="0" Spacing="8" Orientation="Horizontal">
                                            <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="{Binding RouteBlueprint.BlueprintSetIdProvider}" />
                                            <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="{Binding RouteBlueprint.BlueprintSetIdProduct}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding RouteBlueprint.BlueprintId}" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="(" />
                                                <Run FontWeight="Bold" Text="{Binding TrackCount}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,8,*,8,2*" Grid.Column="2"  HorizontalAlignment="Stretch">
                                            <loading:LoadingState Classes="compact" Grid.ColumnSpan="5" DataContext="{Binding Loading}" />
                                            <ComboBox
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding Providers}"
                                                SelectedItem="{Binding SelectedProvider}"
                                                DisplayMemberBinding="{Binding Name}"
                                                PlaceholderText="{echoes:Translate {x:Static translations:Strings.provider}}"
                                            />

                                            <AutoCompleteBox
                                                Grid.Column="0"
                                                Height="32"
                                                IsTextCompletionEnabled="True"
                                                FilterMode="Contains"
                                                PlaceholderText="{echoes:Translate {x:Static translations:Strings.select_provider}}"
                                                ItemsSource="{Binding Providers}"
                                                SelectedItem="{Binding SelectedProvider}"
                                            >
                                                <i:Interaction.Behaviors>
                                                    <bh:AutoCompleteBehaviour/>
                                                </i:Interaction.Behaviors>
                                            </AutoCompleteBox>

                                            <AutoCompleteBox
                                                Grid.Column="2"
                                                Height="32"
                                                IsTextCompletionEnabled="True"
                                                FilterMode="Contains"
                                                PlaceholderText="{echoes:Translate {x:Static translations:Strings.select_product}}"
                                                ItemsSource="{Binding Products}"
                                                SelectedItem="{Binding SelectedProduct}"
                                                IsEnabled="{Binding SelectedProvider, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            >
                                                <i:Interaction.Behaviors>
                                                    <bh:AutoCompleteBehaviour/>
                                                </i:Interaction.Behaviors>
                                            </AutoCompleteBox>

                                            <AutoCompleteBox
                                                Grid.Column="4"
                                                Height="32"
                                                IsTextCompletionEnabled="True"
                                                FilterMode="Contains"
                                                PlaceholderText="{echoes:Translate {x:Static translations:Strings.select_track_blueprint}}"
                                                ItemsSource="{Binding Tracks}"
                                                SelectedItem="{Binding SelectedTrack}"
                                                IsEnabled="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            >
                                                <i:Interaction.Behaviors>
                                                    <bh:AutoCompleteBehaviour/>
                                                </i:Interaction.Behaviors>
                                            </AutoCompleteBox>

                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Height="64" Padding="24,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding DismissCommand}" Content="{echoes:Translate {x:Static translations:Strings.cancel}}" />
                <Button Command="{Binding ReplaceTracksCommand}" Content="{echoes:Translate {x:Static translations:Strings.replace_tracks}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
