<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RailworksForge.Converters"
        xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
        xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
        xmlns:design="using:RailworksForge.DesignData"
             xmlns:loading="using:RailworksForge.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RailworksForge.ViewModels"
        xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RailworksForge.Views.Dialogs.CheckAssetsDialog"
        x:DataType="vm:CheckAssetsViewModel"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Title="{echoes:Translate {x:Static translations:Strings.check_route_assets_title}}">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.CheckAssets" />
    </Design.DataContext>


    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}" Text="{echoes:Translate {x:Static translations:Strings.check_route_asset_availability}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" IsVisible="{Binding IsLoading}" VerticalAlignment="Bottom">
            <Border Padding="48">
                <Grid RowDefinitions="*,Auto,Auto,Auto">
                    <loading:LoadingState Grid.Row="0" DataContext="{Binding Loading}" />
                    <ProgressBar Grid.Row="1" HorizontalAlignment="Stretch" Value="{Binding LoadingProgress}" Minimum="0" Maximum="100" MaxHeight="128" />
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{Binding LoadingMessage}" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding LoadingStatusMessage}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <Panel>
                <DataGrid BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                          ItemsSource="{Binding Blueprints}"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.availability_state}}" Binding="{Binding AcquisitionState, Converter={x:Static converters:ValueConverters.AcquisitionStateConverter}}" />
                        <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.provider}}" Binding="{Binding BlueprintSetIdProvider}" />
                        <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.product}}" Binding="{Binding BlueprintSetIdProduct}" />
                        <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.blueprint_id}}" Binding="{Binding BlueprintId}" />
                    </DataGrid.Columns>
                </DataGrid>
                <loading:LoadingState DataContext="{Binding Loading}" />
            </Panel>
        </DockPanel>

        <Border Grid.Row="2" Height="64" Padding="24,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding DismissCommand}" Content="{echoes:Translate {x:Static translations:Strings.close}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
