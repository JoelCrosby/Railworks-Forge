<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:models="clr-namespace:RailworksForge.Core.Models;assembly=RailworksForge.Core"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RailworksForge.Views.Pages.ScenarioDetailPage"
             x:DataType="vm:ScenarioDetailViewModel">

    <Design.DataContext>
        <vm:DesignScenarioDetailViewModel />
    </Design.DataContext>

    <DockPanel>

        <Grid Margin="12,12,12,0" DockPanel.Dock="Top" ColumnDefinitions="280,*" >
            <Grid.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Spacing" Value="4" />
                    <Setter Property="Margin" Value="0, 0, 0, 8" />
                </Style>

                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="1" />
                    <Setter Property="LineSpacing" Value="1.8" />
                </Style>
            </Grid.Styles>

            <Border Margin="0,0,8,0" Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.locomotive}}" Value="{Binding Scenario.Locomotive}" />
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.start_location}}" Value="{Binding Scenario.StartLocation}" />
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.scenario_type}}" Value="{Binding Scenario.ScenarioClass}" />
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.packaging_type}}" Value="{Binding Scenario.PackagingType}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.description}}" Value="{Binding Scenario.Description}" />
                    <controls:NameValueDisplay Heading="{echoes:Translate {x:Static translations:Strings.briefing}}" Value="{Binding Scenario.Briefing}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel IsEnabled="{Binding Loading.IsIdle}" DockPanel.Dock="Top" Margin="12" Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding OpenInExplorerCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" />
            <Button Command="{Binding OpenBackupsFolder}" Content="{echoes:Translate {x:Static translations:Strings.open_backups_folder}}" />
            <Button Command="{Binding ExportBinXmlCommand}" Content="{echoes:Translate {x:Static translations:Strings.convert_bin_to_xml}}" />
            <Button Command="{Binding ExportXmlBinCommand}" Content="{echoes:Translate {x:Static translations:Strings.convert_xml_to_bin}}" />
            <Button Command="{Binding ExtractScenariosCommand}" Content="{echoes:Translate {x:Static translations:Strings.extract_scenarios}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <controls:TableHeader Text="{echoes:Translate {x:Static translations:Strings.services}}">
                <controls:TableSearchBox SearchTerm="{Binding SearchTerm}" />
            </controls:TableHeader>
        </StackPanel>

        <Panel>
            <DataGrid
                Name="ServicesDataGrid"
                IsEnabled="{Binding Loading.IsIdle}"
                ItemsSource="{Binding Services}"
                SelectionMode="Extended"
                SelectionChanged="ServicesDataGrid_OnSelectionChanged"
                DoubleTapped="ServicesDataGrid_OnDoubleTapped"
            >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.player}}" SortMemberPath="Consist.PlayerDriver">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ConsistViewModel">
                                <Viewbox Classes="cell-icon"
                                         IsVisible="{Binding Consist.PlayerDriver}"
                                         ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.player_driven}}">
                                    <lucideAvalonia:Lucide Icon="UserRound"
                                                           StrokeBrush="{DynamicResource SystemAccentColor}" />
                                </Viewbox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.state}}" SortMemberPath="Consist.ConsistAcquisitionState">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ConsistViewModel">
                                <controls:AcquisitionStateIcon Classes="cell" State="{Binding Consist.ConsistAcquisitionState}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- The thumbnail is not sortable, so pairing it with the name keeps sorting by locomotive name intact. -->
                    <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.locomotive}}" SortMemberPath="Consist.LocomotiveName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ConsistViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,12,0">
                                    <Border Classes="thumbnail" Width="92" Height="52" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <Panel>
                                            <lucideAvalonia:Lucide Icon="TrainFront" StrokeBrush="{DynamicResource TextControlPlaceholderForeground}" StrokeThickness="1.5" Width="20" Height="20" />
                                            <Image Stretch="UniformToFill" Source="{Binding ImageBitmap}" />
                                        </Panel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Consist.LocomotiveName}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.service_name}}" Binding="{Binding Consist.ServiceName}" />

                    <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.length}}" SortMemberPath="Consist.Length">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ConsistViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.consist_length}}">
                                    <Viewbox Classes="inline-icon">
                                        <lucideAvalonia:Lucide Icon="TrainFront" />
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Consist.Length}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Provider, product and blueprint path together identify the asset; the column sorts by provider. -->
                    <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.blueprint}}" Width="*" MinWidth="200" SortMemberPath="Consist.BlueprintSetIdProvider">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ConsistViewModel">
                                <controls:BlueprintSummary Margin="12,0"
                                                           Provider="{Binding Consist.BlueprintSetIdProvider}"
                                                           Product="{Binding Consist.BlueprintSetIdProduct}"
                                                           BlueprintId="{Binding Consist.BlueprintId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_details}}" Command="{Binding ClickedConsistCommand}" />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.replace_with_quick_drive_consist}}" Command="{Binding ReplaceConsistCommand}"  />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.delete_service}}" Command="{Binding DeleteConsistCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Styles>
                    <Style Selector="DataGridRow">
                        <Setter Property="MinHeight" Value="64" />
                    </Style>
                </DataGrid.Styles>
            </DataGrid>
            <loading:LoadingState DataContext="{Binding Loading}" />
        </Panel>

    </DockPanel>
</UserControl>
