<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
             xmlns:bh="using:RailworksForge.Behaviours"
             xmlns:design="using:RailworksForge.DesignData"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:components="using:RailworksForge.Views.Components"
             xmlns:scenarios="clr-namespace:RailworksForge.Core.Scenarios;assembly=RailworksForge.Core"
             xmlns:converters="clr-namespace:RailworksForge.Converters"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RailworksForge.Views.Pages.RouteDetailPage"
             x:DataType="vm:RouteDetailViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.RouteDetail" />
    </Design.DataContext>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding OpenScenarioCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <components:PageHeader DockPanel.Dock="Top"
                               Image="{Binding Route.ImageBitmap}"
                               PlaceholderIcon="Route"
                               Title="{Binding Route.Name}">
            <components:PageHeader.Badges>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <components:Badge Content="{Binding ScenarioCountText}" />
                    <components:Badge Classes="success" Content="{Binding CompletedText}" />
                    <components:Badge Content="{Binding Route.PackagingType, Converter={x:Static converters:ValueConverters.PackagingTypeConverter}}" />
                </WrapPanel>
            </components:PageHeader.Badges>
            <components:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Loading.IsIdle}">
                    <Button Command="{Binding CheckAssetsCommand}">
                        <components:IconLabel Icon="ListChecks" Text="{echoes:Translate {x:Static translations:Strings.check_assets}}" />
                    </Button>
                    <Button>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" Command="{Binding OpenInExplorerCommand}" />
                                <Separator />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.changes_route_files}}" IsEnabled="False" />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.edit_route_details}}" Command="{Binding EditRouteDetailsCommand}" />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.replace_track_action}}"
                                          Foreground="{DynamicResource WarningTextBrush}"
                                          Command="{Binding ReplaceTrackCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center" Text="{echoes:Translate {x:Static translations:Strings.route_tools}}" />
                            <components:LucideIcon Icon="ChevronDown" Width="14" Height="14" StrokeThickness="2" StrokeBrush="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </components:PageHeader.Actions>
        </components:PageHeader>

        <WrapPanel DockPanel.Dock="Top" Margin="24,0,24,12" ItemSpacing="8" LineSpacing="8">
            <Button Classes="chip" Classes.on="{Binding IsShowingAll}"
                    Command="{Binding ShowCompletionCommand}" CommandParameter="{x:Static vm:CompletionFilter.All}"
                    Content="{echoes:Translate {x:Static translations:Strings.filter_all}}" />
            <Button Classes="chip" Classes.on="{Binding IsShowingNotCompleted}"
                    Command="{Binding ShowCompletionCommand}" CommandParameter="{x:Static vm:CompletionFilter.NotCompleted}"
                    Content="{echoes:Translate {x:Static translations:Strings.filter_not_completed}}" />
            <Button Classes="chip" Classes.on="{Binding IsShowingCompleted}"
                    Command="{Binding ShowCompletionCommand}" CommandParameter="{x:Static vm:CompletionFilter.Completed}"
                    Content="{echoes:Translate {x:Static translations:Strings.filter_completed}}" />
            <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource DividerBrush}" />
            <Button Classes="chip" Classes.on="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Spring}"
                    Command="{Binding ToggleSeasonCommand}" CommandParameter="Spring"
                    Content="{echoes:Translate {x:Static translations:Strings.season_spring}}" />
            <Button Classes="chip" Classes.on="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Summer}"
                    Command="{Binding ToggleSeasonCommand}" CommandParameter="Summer"
                    Content="{echoes:Translate {x:Static translations:Strings.season_summer}}" />
            <Button Classes="chip" Classes.on="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Autumn}"
                    Command="{Binding ToggleSeasonCommand}" CommandParameter="Autumn"
                    Content="{echoes:Translate {x:Static translations:Strings.season_autumn}}" />
            <Button Classes="chip" Classes.on="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Winter}"
                    Command="{Binding ToggleSeasonCommand}" CommandParameter="Winter"
                    Content="{echoes:Translate {x:Static translations:Strings.season_winter}}" />
        </WrapPanel>

        <Border Classes="card" Margin="24,0,24,16">
            <DockPanel>
                <components:SectionHeader DockPanel.Dock="Top"
                                          Title="{echoes:Translate {x:Static translations:Strings.scenarios}}"
                                          Count="{Binding Scenarios.Count}">
                    <components:SearchBox IsShortcutTarget="True"
                                          ShortcutHint="{echoes:Translate {x:Static translations:Strings.search_shortcut}}"
                                          Placeholder="{Binding SearchPlaceholder}"
                                          Text="{Binding SearchTerm}" />
                </components:SectionHeader>

                <Panel>
                    <DataGrid
                        Name="ScenariosDataGrid"
                        IsEnabled="{Binding Loading.IsIdle}"
                        ItemsSource="{Binding Scenarios}"
                        SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                        SelectionMode="Single"
                    >
                        <i:Interaction.Behaviors>
                            <bh:ItemDoubleTapCommandBehaviour Command="{Binding OpenScenarioCommand}" />
                        </i:Interaction.Behaviors>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.completed}}" SortMemberPath="PlayerInfo.Completion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <Viewbox Classes="cell-icon"
                                                 IsVisible="{Binding PlayerInfo.Completion, Converter={x:Static converters:ValueConverters.IsCompleteConverter}}"
                                                 ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.completed}}">
                                            <components:LucideIcon Icon="CircleCheckBig"
                                                                   StrokeBrush="{DynamicResource SuccessBrush}" />
                                        </Viewbox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.name}}" Binding="{Binding Scenario.Name}" />
                            <!-- The thumbnail is not sortable, so pairing it with the name keeps sorting by locomotive intact. -->
                            <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.locomotive}}" SortMemberPath="Scenario.Locomotive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,6">
                                            <components:Thumbnail Width="64" Height="36" Source="{Binding LocomotiveImage}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Locomotive}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.type}}" SortMemberPath="Scenario.ScenarioClass">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                            <Viewbox Classes="inline-icon"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding Scenario.ScenarioClass, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static scenarios:ScenarioClass.Unknown}}">
                                                <components:LucideIcon Icon="{Binding Scenario.ScenarioClass, Converter={x:Static converters:ValueConverters.ScenarioClassIconConverter}}" />
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.ScenarioClass, Converter={x:Static converters:ValueConverters.ScenarioClassConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.duration}}" SortMemberPath="Scenario.Duration">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0">
                                            <Viewbox Classes="inline-icon">
                                                <components:LucideIcon Icon="Clock3" />
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Duration, Converter={x:Static converters:ValueConverters.DurationConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.season}}" SortMemberPath="Scenario.Season">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                            <Viewbox Classes="inline-icon"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding Scenario.Season, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <components:LucideIcon Icon="{Binding Scenario.Season, Converter={x:Static converters:ValueConverters.SeasonIconConverter}}" />
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Season, Converter={x:Static converters:ValueConverters.SeasonConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.details}}" Command="{Binding OpenScenarioCommand}" />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.copy}}" Command="{Binding CopyScenarioNameCommand}" />
                                <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" Command="{Binding OpenScenarioInExplorerCommand}"  />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <loading:LoadingState DataContext="{Binding Loading}" />
                    <components:EmptyState Icon="SearchX"
                                           Title="{echoes:Translate {x:Static translations:Strings.no_matches}}"
                                           IsVisible="{Binding ShowsNoMatches}" />
                </Panel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
