<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
             xmlns:bh="using:RailworksForge.Behaviours"
             xmlns:design="using:RailworksForge.DesignData"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
             xmlns:models="clr-namespace:RailworksForge.Core.Models;assembly=RailworksForge.Core"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:converters="clr-namespace:RailworksForge.Converters"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RailworksForge.Views.Pages.RouteDetailPage"
             x:DataType="vm:RouteDetailViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.RouteDetail" />
    </Design.DataContext>

    <DockPanel>
        <Grid Margin="12,12,12,0" DockPanel.Dock="Top" ColumnDefinitions="280,*" >
            <Grid.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Spacing" Value="4" />
                    <Setter Property="Margin" Value="0, 0, 0, 8" />
                </Style>

                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="1" />
                    <Setter Property="LineSpacing" Value="1.8" />
                </Style>
            </Grid.Styles>

            <Border Background="Black" Margin="0,0,8,0" Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <Image Width="272" Height="146" Source="{Binding Route.ImageBitmap}" Stretch="UniformToFill" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{echoes:Translate {x:Static translations:Strings.name}}" />
                        <TextBlock Text="{Binding Route.Name}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{echoes:Translate {x:Static translations:Strings.packaging_type}}" />
                        <TextBlock Text="{Binding Route.PackagingType, Converter={x:Static converters:ValueConverters.PackagingTypeConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel IsEnabled="{Binding Loading.IsIdle}" DockPanel.Dock="Top" Margin="12" Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding OpenInExplorerCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" />
            <Button Command="{Binding CheckAssetsCommand}" Content="{echoes:Translate {x:Static translations:Strings.check_asset_availability}}" />
            <Button Command="{Binding ReplaceTrackCommand}" Content="{echoes:Translate {x:Static translations:Strings.replace_track}}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
            <controls:TableHeader Text="{echoes:Translate {x:Static translations:Strings.scenarios}}">
                <controls:TableSearchBox SearchTerm="{Binding SearchTerm}" />
            </controls:TableHeader>
        </StackPanel>


        <Panel>
            <DataGrid
                Name="ScenariosDataGrid"
                IsEnabled="{Binding Loading.IsIdle}"
                ItemsSource="{Binding Scenarios}"
                SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                SelectionMode="Single"
            >
                <i:Interaction.Behaviors>
                    <bh:ItemDoubleTapCommandBehaviour Command="{Binding OpenScenarioCommand}" />
                </i:Interaction.Behaviors>

                <DataGrid.Columns>
                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.completed}}" SortMemberPath="PlayerInfo.Completion">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <Viewbox Classes="cell-icon"
                                     IsVisible="{Binding PlayerInfo.Completion, Converter={x:Static converters:ValueConverters.IsCompleteConverter}}"
                                     ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.completed}}">
                                <lucideAvalonia:Lucide Icon="CircleCheckBig"
                                                       StrokeBrush="{DynamicResource SuccessBrush}" />
                            </Viewbox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.name}}" Binding="{Binding Scenario.Name}" />
                <!-- The thumbnail is not sortable, so pairing it with the name keeps sorting by locomotive intact. -->
                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.locomotive}}" SortMemberPath="Scenario.Locomotive">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,6">
                                <controls:VehicleThumbnail Width="64" Height="36" Source="{Binding LocomotiveImage}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Locomotive}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.type}}" SortMemberPath="Scenario.ScenarioClass">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                <Viewbox Classes="inline-icon"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding Scenario.ScenarioClass, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static models:ScenarioClass.Unknown}}">
                                    <lucideAvalonia:Lucide Icon="{Binding Scenario.ScenarioClass, Converter={x:Static converters:ValueConverters.ScenarioClassIconConverter}}" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.ScenarioClass, Converter={x:Static converters:ValueConverters.ScenarioClassConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.duration}}" SortMemberPath="Scenario.Duration">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0">
                                <Viewbox Classes="inline-icon">
                                    <lucideAvalonia:Lucide Icon="Clock3" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Duration, Converter={x:Static converters:ValueConverters.DurationConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.rating}}" SortMemberPath="Scenario.Rating">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <TextBlock Margin="12,0"
                                       VerticalAlignment="Center"
                                       LetterSpacing="1"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       Text="{Binding Scenario.Rating, Converter={x:Static converters:ValueConverters.RatingConverter}}"
                                       ToolTip.Tip="{Binding Scenario.Rating}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.season}}" SortMemberPath="Scenario.Season">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                <Viewbox Classes="inline-icon"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding Scenario.Season, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <lucideAvalonia:Lucide Icon="{Binding Scenario.Season, Converter={x:Static converters:ValueConverters.SeasonIconConverter}}" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Scenario.Season, Converter={x:Static converters:ValueConverters.SeasonConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.score}}" Binding="{Binding PlayerInfo.Score}" />

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.packaging}}" SortMemberPath="Scenario.PackagingType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ScenarioRowViewModel">
                            <Panel>
                                <Viewbox Classes="cell-icon"
                                         IsVisible="{Binding Scenario.PackagingType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:PackagingType.Packed}}"
                                         ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.packed}}">
                                    <lucideAvalonia:Lucide Icon="Package"
                                                           StrokeBrush="{DynamicResource TextControlForeground}" />
                                </Viewbox>
                                <Viewbox Classes="cell-icon"
                                         IsVisible="{Binding Scenario.PackagingType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:PackagingType.Unpacked}}"
                                         ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.unpacked}}">
                                    <lucideAvalonia:Lucide Icon="FolderOpen"
                                                           StrokeBrush="{DynamicResource TextControlPlaceholderForeground}" />
                                </Viewbox>
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.details}}" Command="{Binding OpenScenarioCommand}" />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.copy}}" Command="{Binding CopyScenarioNameCommand}" />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" Command="{Binding OpenScenarioInExplorerCommand}"  />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
            <loading:LoadingState DataContext="{Binding Loading}" />
        </Panel>

    </DockPanel>

</UserControl>
