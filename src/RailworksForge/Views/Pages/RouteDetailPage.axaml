<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="using:RailworksForge.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:controls="clr-namespace:RailworksForge.Views.TemplatedControls"
             xmlns:models="clr-namespace:RailworksForge.Core.Models;assembly=RailworksForge.Core"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:converters="clr-namespace:RailworksForge.Converters"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             x:CompileBindings="True"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="RailworksForge.Views.Pages.RouteDetailPage"
             x:DataType="vm:RouteDetailViewModel">

    <Design.DataContext>
        <vm:DesignRouteDetailViewModel />
    </Design.DataContext>

    <DockPanel>
        <Grid Margin="12,12,12,0" DockPanel.Dock="Top" ColumnDefinitions="280,*" >
            <Grid.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Spacing" Value="4" />
                    <Setter Property="Margin" Value="0, 0, 0, 8" />
                </Style>

                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="1" />
                    <Setter Property="LineSpacing" Value="1.8" />
                </Style>
            </Grid.Styles>

            <Border Background="Black" Margin="0,0,8,0" Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <Image Width="272" Height="146" Source="{Binding Route.ImageBitmap}" Stretch="UniformToFill" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" Padding="12,8" CornerRadius="6">
                <StackPanel>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{echoes:Translate {x:Static translations:Strings.name}}" />
                        <TextBlock Text="{Binding Route.Name}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{echoes:Translate {x:Static translations:Strings.packaging_type}}" />
                        <TextBlock Text="{Binding Route.PackagingType}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel IsEnabled="{Binding Loading.IsIdle}" DockPanel.Dock="Top" Margin="12" Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding OpenInExplorerCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" />
            <Button Command="{Binding CheckAssetsCommand}" Content="{echoes:Translate {x:Static translations:Strings.check_asset_availability}}" />
            <Button Command="{Binding ReplaceTrackCommand}" Content="{echoes:Translate {x:Static translations:Strings.replace_track}}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
            <controls:TableHeader Text="{echoes:Translate {x:Static translations:Strings.scenarios}}">
                <controls:TableSearchBox SearchTerm="{Binding SearchTerm}" />
            </controls:TableHeader>
        </StackPanel>


        <Panel>
            <DataGrid
                Name="ScenariosDataGrid"
                IsEnabled="{Binding Loading.IsIdle}"
                ItemsSource="{Binding Scenarios}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Single"
                DoubleTapped="ScenariosDataGrid_OnDoubleTapped"
            >
                <DataGrid.Columns>
                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.completed}}" SortMemberPath="PlayerInfo.Completion">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <Viewbox Classes="cell-icon"
                                     IsVisible="{Binding PlayerInfo.Completion, Converter={x:Static converters:ValueConverters.IsCompleteConverter}}"
                                     ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.completed}}">
                                <lucideAvalonia:Lucide Icon="CircleCheckBig"
                                                       StrokeBrush="{DynamicResource SuccessBrush}" />
                            </Viewbox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.name}}" Binding="{Binding Name}" />
                <!-- The thumbnail is not sortable, so pairing it with the name keeps sorting by locomotive intact. -->
                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.locomotive}}" SortMemberPath="Locomotive">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,6">
                                <controls:VehicleThumbnail Width="64" Height="36" Source="{Binding LocomotiveImage}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Locomotive}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.type}}" SortMemberPath="ScenarioClass">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                <Panel VerticalAlignment="Center">
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding ScenarioClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ScenarioClass.Standard}}">
                                        <lucideAvalonia:Lucide Icon="Flag" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding ScenarioClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ScenarioClass.FreeRoam}}">
                                        <lucideAvalonia:Lucide Icon="MapPinned" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding ScenarioClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ScenarioClass.Career}}">
                                        <lucideAvalonia:Lucide Icon="Trophy" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding ScenarioClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ScenarioClass.Timetable}}">
                                        <lucideAvalonia:Lucide Icon="CalendarClock" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding ScenarioClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ScenarioClass.Template}}">
                                        <lucideAvalonia:Lucide Icon="LayoutTemplate" />
                                    </Viewbox>
                                </Panel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding ScenarioClass}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.duration}}" SortMemberPath="Duration">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0">
                                <Viewbox Classes="inline-icon">
                                    <lucideAvalonia:Lucide Icon="Clock3" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Duration, Converter={x:Static converters:ValueConverters.DurationConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.rating}}" SortMemberPath="Rating">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <TextBlock Margin="12,0"
                                       VerticalAlignment="Center"
                                       LetterSpacing="1"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       Text="{Binding Rating, Converter={x:Static converters:ValueConverters.RatingConverter}}"
                                       ToolTip.Tip="{Binding Rating}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.season}}" SortMemberPath="Season">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                                <Panel VerticalAlignment="Center">
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Spring}">
                                        <lucideAvalonia:Lucide Icon="Flower2" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Summer}">
                                        <lucideAvalonia:Lucide Icon="SunMedium" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Autumn}">
                                        <lucideAvalonia:Lucide Icon="Leaf" />
                                    </Viewbox>
                                    <Viewbox Classes="inline-icon"
                                             IsVisible="{Binding Season, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Winter}">
                                        <lucideAvalonia:Lucide Icon="Snowflake" />
                                    </Viewbox>
                                </Panel>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Season}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{echoes:Translate {x:Static translations:Strings.score}}" Binding="{Binding PlayerInfo.Score}" />

                <DataGridTemplateColumn Header="{echoes:Translate {x:Static translations:Strings.packaging}}" SortMemberPath="PackagingType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Scenario">
                            <Panel>
                                <Viewbox Classes="cell-icon"
                                         IsVisible="{Binding PackagingType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:PackagingType.Packed}}"
                                         ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.packed}}">
                                    <lucideAvalonia:Lucide Icon="Package"
                                                           StrokeBrush="{DynamicResource TextControlForeground}" />
                                </Viewbox>
                                <Viewbox Classes="cell-icon"
                                         IsVisible="{Binding PackagingType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:PackagingType.Unpacked}}"
                                         ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.unpacked}}">
                                    <lucideAvalonia:Lucide Icon="FolderOpen"
                                                           StrokeBrush="{DynamicResource TextControlPlaceholderForeground}" />
                                </Viewbox>
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.details}}" Command="{Binding DetailsClickedCommand}" />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.copy}}" Command="{Binding CopyClickedCommand}" />
                        <MenuItem Header="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" Command="{Binding OpenScenarioInExplorerCommand}"  />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
            <loading:LoadingState DataContext="{Binding Loading}" />
        </Panel>

    </DockPanel>

</UserControl>
