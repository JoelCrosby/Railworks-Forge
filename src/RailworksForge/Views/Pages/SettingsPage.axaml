<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:RailworksForge.DesignData"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailworksForge.ViewModels"
             xmlns:components="using:RailworksForge.Views.Components"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:translations="clr-namespace:RailworksForge.Translations;assembly=RailworksForge.Translations"
             xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900"
             x:Class="RailworksForge.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <x:Static Member="design:DesignViewModels.Settings" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="MinWidth" Value="200" />
        </Style>

        <Style Selector="lucideAvalonia|Lucide.warning">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeBrush" Value="{DynamicResource WarningTextBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="24,0,24,24" MaxWidth="860" HorizontalAlignment="Left">

            <components:SettingsSection Title="{echoes:Translate {x:Static translations:Strings.general}}">
                <StackPanel>
                    <components:SettingsRow Title="{echoes:Translate {x:Static translations:Strings.game_directory}}"
                                            Description="{echoes:Translate {x:Static translations:Strings.game_directory_description}}">
                        <components:SettingsRow.Footer>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             IsReadOnly="True"
                                             Text="{Binding GameDirectoryPath}"
                                             PlaceholderText="{echoes:Translate {x:Static translations:Strings.game_directory_not_set}}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                        <Button Command="{Binding BrowseGameDirectoryCommand}" Content="{echoes:Translate {x:Static translations:Strings.browse}}" />
                                        <Button Command="{Binding OpenGameDirectoryCommand}"
                                                IsEnabled="{Binding IsGameDirectoryValid}"
                                                Content="{echoes:Translate {x:Static translations:Strings.open_in_explorer}}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsGameDirectoryInvalid}">
                                    <components:LucideIcon Classes="warning" Icon="TriangleAlert" />
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" Text="{echoes:Translate {x:Static translations:Strings.game_directory_invalid}}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsGameDirectorySet}">
                                    <components:LucideIcon Classes="warning" Icon="TriangleAlert" />
                                    <TextBlock Foreground="{DynamicResource WarningTextBrush}" Text="{echoes:Translate {x:Static translations:Strings.game_directory_not_set}}" />
                                </StackPanel>

                                <Border IsVisible="{Binding IsRestartRequired}"
                                        Padding="12,8"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Background="{DynamicResource AccentSubtleBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <components:LucideIcon Grid.Column="0" Icon="RotateCw" Width="16" Height="16" StrokeThickness="2" Margin="0,0,8,0" StrokeBrush="{DynamicResource AccentSubtleForegroundBrush}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AccentSubtleForegroundBrush}" Text="{echoes:Translate {x:Static translations:Strings.restart_required}}" />
                                        <Button Grid.Column="2" Margin="12,0,0,0" Classes="primary" Command="{Binding RestartCommand}" Content="{echoes:Translate {x:Static translations:Strings.restart_now}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </components:SettingsRow.Footer>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsSection>

            <components:SettingsSection Title="{echoes:Translate {x:Static translations:Strings.appearance}}">
                <StackPanel>
                    <components:SettingsRow Title="{echoes:Translate {x:Static translations:Strings.theme}}"
                                            Description="{echoes:Translate {x:Static translations:Strings.theme_description}}">
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberBinding="{Binding Header, x:DataType=vm:SettingsOption}" />
                    </components:SettingsRow>

                    <components:SettingsRow Title="{echoes:Translate {x:Static translations:Strings.language}}"
                                            Description="{echoes:Translate {x:Static translations:Strings.language_description}}">
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberBinding="{Binding Header, x:DataType=vm:SettingsOption}" />
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsSection>

            <components:SettingsSection Title="{echoes:Translate {x:Static translations:Strings.file_conversion}}">
                <StackPanel>
                    <components:SettingsRow Title="{echoes:Translate {x:Static translations:Strings.use_internal_serz}}"
                                            Description="{echoes:Translate {x:Static translations:Strings.use_internal_serz_description}}">
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding UseInternalSerz}" />
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsSection>

            <components:SettingsSection Title="{echoes:Translate {x:Static translations:Strings.tables}}">
                <StackPanel>
                    <components:SettingsRow Title="{echoes:Translate {x:Static translations:Strings.reset_table_sorting}}"
                                            Description="{echoes:Translate {x:Static translations:Strings.reset_table_sorting_description}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       IsVisible="{Binding IsTableSortingReset}"
                                       Text="{echoes:Translate {x:Static translations:Strings.table_sorting_reset}}" />
                            <Button Command="{Binding ResetTableSortingCommand}" Content="{echoes:Translate {x:Static translations:Strings.reset_table_sorting}}" />
                        </StackPanel>
                    </components:SettingsRow>
                </StackPanel>
            </components:SettingsSection>

            <components:SettingsSection Title="{echoes:Translate {x:Static translations:Strings.files_and_folders}}">
                <WrapPanel Margin="16,12" ItemSpacing="8" LineSpacing="8">
                    <Button Command="{Binding OpenSettingsFolderCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_settings_folder}}" />
                    <Button Command="{Binding OpenLogsFolderCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_logs_folder}}" />
                    <Button Command="{Binding OpenCacheFolderCommand}" Content="{echoes:Translate {x:Static translations:Strings.open_cache_folder}}" />
                </WrapPanel>
            </components:SettingsSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
